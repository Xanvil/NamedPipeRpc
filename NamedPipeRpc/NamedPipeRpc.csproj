<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFrameworks / LangVersion / Nullable / ImplicitUsings / Version 见 Directory.Build.props -->
    <RootNamespace>Xanvil.NamedPipeRpc</RootNamespace>
    <IsPackable>true</IsPackable>

    <!-- NuGet 包元数据（nuget.org 展示与校验） -->
    <PackageId>NamedPipeRpc</PackageId>
    <Title>NamedPipeRpc</Title>
    <Authors>Xanvil</Authors>
    <Company>Xanvil</Company>
    <Product>NamedPipeRpc</Product>
    <Description>基于 Windows 命名管道的双向 RPC 库（命名空间 Xanvil.NamedPipeRpc），面向同机进程间 IPC。支持 Request / Notify / 订阅推送；目标框架 net472 与 net8.0。</Description>
    <PackageTags>named-pipe;rpc;ipc;windows;dotnet;xanvil</PackageTags>
    <PackageProjectUrl>https://github.com/Xanvil/NamedPipeRpc</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Xanvil/NamedPipeRpc</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- nuget.org 当前版本的发布说明；随 nupkg 的 nuspec releaseNotes 展示 -->
    <PackageReleaseNotes>1.1.0
- 增加契约特性 [RpcRequest]、[RpcNotify]、[RpcMethod]。Source Generator 生成 Add*Handler、AddNotifyProxy，以及连接上的 GetRequestProxy / GetNotifyProxy。
- 通知契约把接收和自动订阅分开：AddNotifyHandler 只登记本端可以接收，AddNotifyProxy 才在连接后自动订阅。
- 两端不必共享契约程序集，按 RPC 方法名和 JSON 形状互通。两个及以上业务参数打成参数包，缺少的字段使用类型默认值。
- 非法契约在编译期报告 NPRC001–NPRC007。NuGet 包附带 Generator 与 buildTransitive targets。</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- 将库 README 打入 nupkg，供 nuget.org 包详情页展示 -->
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- NuGet 消费方自动获得 Source Generator -->
    <None Include="buildTransitive\NamedPipeRpc.targets" Pack="true" PackagePath="buildTransitive\NamedPipeRpc.targets" />
  </ItemGroup>

  <ItemGroup>
    <!-- 版本见 Directory.Packages.props -->
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="System.Threading.Channels" />
  </ItemGroup>

  <!-- 开发时作为 Analyzer 引用；打包时写入 analyzers/dotnet/cs -->
  <ItemGroup>
    <ProjectReference Include="..\NamedPipeRpc.Generators\NamedPipeRpc.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!--
    将 Source Generator 打入 analyzers/dotnet/cs。
    须写入 _PackageFiles（而非运行时再加 None Pack=true），否则 GenerateNuspec 收不到。
    缺 DLL 时必须失败，禁止产出不含生成器的 nupkg。
  -->
  <Target Name="PackRpcGenerators" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_RpcGeneratorsProj>$(MSBuildThisFileDirectory)..\NamedPipeRpc.Generators\NamedPipeRpc.Generators.csproj</_RpcGeneratorsProj>
      <_RpcGeneratorsDll>$(MSBuildThisFileDirectory)..\NamedPipeRpc.Generators\bin\$(Configuration)\netstandard2.0\NamedPipeRpc.Generators.dll</_RpcGeneratorsDll>
    </PropertyGroup>
    <MSBuild Projects="$(_RpcGeneratorsProj)" Targets="Build" Properties="Configuration=$(Configuration)" />
    <Error Text="NamedPipeRpc.Generators.dll 未找到：$(_RpcGeneratorsDll)。请先构建 NamedPipeRpc.Generators 再 pack。" Condition="!Exists('$(_RpcGeneratorsDll)')" />
    <ItemGroup>
      <_PackageFiles Include="$(_RpcGeneratorsDll)">
        <PackagePath>analyzers/dotnet/cs/</PackagePath>
        <Visible>false</Visible>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
    </ItemGroup>
  </Target>

</Project>

