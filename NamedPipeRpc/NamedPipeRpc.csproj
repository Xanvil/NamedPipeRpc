<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFrameworks / LangVersion / Nullable / ImplicitUsings / Version 见 Directory.Build.props -->
    <RootNamespace>Xanvil.NamedPipeRpc</RootNamespace>
    <IsPackable>true</IsPackable>

    <!-- NuGet 包元数据（nuget.org 展示与校验） -->
    <PackageId>NamedPipeRpc</PackageId>
    <Title>NamedPipeRpc</Title>
    <Authors>Xanvil</Authors>
    <Company>Xanvil</Company>
    <Product>NamedPipeRpc</Product>
    <Description>基于 Windows 命名管道的双向 RPC 库（命名空间 Xanvil.NamedPipeRpc），面向同机进程间 IPC。支持 Request / Notify / 订阅推送；目标框架 net472 与 net8.0。</Description>
    <PackageTags>named-pipe;rpc;ipc;windows;dotnet;xanvil</PackageTags>
    <PackageProjectUrl>https://github.com/Xanvil/NamedPipeRpc</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Xanvil/NamedPipeRpc</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- 将库 README 打入 nupkg，供 nuget.org 包详情页展示 -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- 版本见 Directory.Packages.props -->
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="System.Threading.Channels" />
  </ItemGroup>

</Project>
